{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minima Studio",
  "version": "1.0.0",
  "identifier": "be.minimalist.minimastudio.windows",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Minima Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0B0C0E"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Minimalist Belgium",
    "copyright": "Minimalist Belgium",
    "category": "Productivity",
    "shortDescription": "Missions, deadlines et temps de montage",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["French"],
        "installMode": "currentUser"
      }
    }
  }
}
