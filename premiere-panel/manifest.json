{
  "manifestVersion": 5,
  "id": "be.minimalist.minimastudio.premiere",
  "name": "Minima Studio",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0",
    "data": { "loadEvent": "startup" }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "minimaPanel",
      "label": { "default": "Minima Studio" },
      "minimumSize": { "width": 220, "height": 150 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 280, "height": 240 },
      "preferredFloatingSize": { "width": 300, "height": 260 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/icon-23.png", "scale": [1, 2], "theme": ["all"] }
      ]
    }
  ],
  "icons": [
    { "width": 24, "height": 24, "path": "icons/icon-24.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "network": { "domains": ["https://jkfighpoftczgszgoidp.supabase.co"] }
  }
}
